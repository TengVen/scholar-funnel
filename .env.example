# ── MySQL 数据库 ──
MYSQL_URL=mysql+pymysql://user:password@localhost:3306/litfunnel

# ── LLM 配置 ──
LLM_PROVIDER=deepseek
LLM_API_KEY=your-api-key-here

# ── 认证：JWT 签名密钥（必填，缺失将导致启动失败）──
# 生成：python -c "import secrets; print('JWT_SECRET=' + secrets.token_urlsafe(48))"
JWT_SECRET=your-strong-random-secret-here

# ── 可选：OpenAlex 邮箱（提高 API 速率）──
# OPENALEX_EMAIL=your@email.com
